{
  "name": "SoDA MLOps Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {"ghcr.io/devcontainers/features/docker-in-docker:2": {}},
  "forwardPorts": [8000, 8001],
  "portsAttributes": {
    "8000": {"label": "SoDA Digit Lab", "onAutoForward": "openBrowser"},
    "8001": {"label": "Packaged Docker demo", "onAutoForward": "notify"}
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt && python -m ml.train",
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-toolsai.jupyter"]}},
  "hostRequirements": {"cpus": 2, "memory": "4gb", "storage": "16gb"}
}
